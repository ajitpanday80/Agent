LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=msp-helpdesk
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Zoho Desk is required: it is the authoritative ticket system.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_DESK_API_URL=https://desk.zoho.in/api/v1
ZOHO_DESK_ORG_ID=
ZOHO_DESK_DEPARTMENT_ID=
ZOHO_DESK_WEB_URL=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Optional: priority:acknowledgement-minutes/resolution-hours. Replace with contracted targets.
# MSP_SLA=1:10/4,2:15/8,3:60/48,4:240/120

# Admin console (set a long random secret for deployments)
HELPDESK_ADMIN_USER=admin
HELPDESK_ADMIN_PASSWORD=
HELPDESK_SESSION_SECRET=
HELPDESK_HOST=127.0.0.1
HELPDESK_PORT=5000
HELPDESK_COOKIE_SECURE=false

# SQLite contains KB, routing configuration, voicemail intake, and audit records only.
# It does not store tickets.
# MSP_DB=data/msp.db

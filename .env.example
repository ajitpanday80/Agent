LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Zoho Desk (optional). Leave blank to use only the local mock PSA.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_DESK_API_URL=https://desk.zoho.in/api/v1
ZOHO_DESK_ORG_ID=
ZOHO_DESK_DEPARTMENT_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Comma-separated contact emails treated as VIP (priority bumped one level)
MSP_VIP_EMAILS=

# ---- Production (python -m msp_agent.preflight lists what is still blocking) ----
# MSP_ENV=production            # agent REFUSES to start while any check fails
# KB_REQUIRE_REVIEWED=true      # only human-approved KB articles are used
# MSP_SLA=1:10/4,2:15/8,3:60/48,4:240/120   # priority:ack_minutes/resolve_hours, from YOUR contracts
# MSP_TZ=Asia/Kolkata
# MSP_HOURS=09:00-18:00
# ALLOW_CALLBACK_ONLY=true      # live transfer is not built; accept that escalation = promised callback
# TELEPHONY_VERIFIED=true       # set only after a real inbound call reached the agent
# LEGAL_REVIEWED=true           # set only after recording / AI-disclosure rules were confirmed
